{
  "manifest_version": 3,
  "name": "AppliedIn \u2014 Job Application Tracker",
  "version": "1.1.3",
  "description": "Auto-track your job applications from LinkedIn, Naukri, Internshala and more. Reminders, backup and insights. 100% private, free.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://appliedin.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AppliedIn",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.apna.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.cutshort.io/*",
        "https://*.darwinbox.com/*",
        "https://*.darwinbox.in/*",
        "https://*.forms.cloud.microsoft/*",
        "https://*.forms.microsoft.com/*",
        "https://*.forms.office.com/*",
        "https://*.foundit.in/*",
        "https://*.freshersworld.com/*",
        "https://*.freshteam.com/*",
        "https://*.greenhouse.io/*",
        "https://*.hirist.com/*",
        "https://*.hirist.tech/*",
        "https://*.icims.com/*",
        "https://*.instahyre.com/*",
        "https://*.internshala.com/*",
        "https://*.jobvite.com/*",
        "https://*.jotform.com/*",
        "https://*.keka.com/*",
        "https://*.lever.co/*",
        "https://*.linkedin.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.naukri.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.peoplestrong.com/*",
        "https://*.recruitee.com/*",
        "https://*.shine.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.springrecruit.com/*",
        "https://*.successfactors.com/*",
        "https://*.successfactors.eu/*",
        "https://*.taleo.net/*",
        "https://*.tally.so/*",
        "https://*.teamtailor.com/*",
        "https://*.timesjobs.com/*",
        "https://*.typeform.com/*",
        "https://*.unstop.com/*",
        "https://*.wellfound.com/*",
        "https://*.workable.com/*",
        "https://*.workday.com/*",
        "https://*.zfrmz.com/*",
        "https://*.zfrmz.in/*",
        "https://*.zohopublic.com/*",
        "https://*.zohopublic.in/*",
        "https://*.zohorecruit.com/*",
        "https://*.zohorecruit.in/*",
        "https://docs.google.com/forms/*",
        "https://forms.gle/*",
        "https://forms.google.com/*"
      ],
      "js": [
        "lib/shared.js",
        "content/adapters.js",
        "content/core.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.indeed.com/*",
        "https://*.glassdoor.com/*",
        "https://*.glassdoor.co.in/*"
      ],
      "js": [
        "lib/shared.js",
        "content/adapters.js",
        "content/core.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}